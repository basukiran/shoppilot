# =============================================================================
# BookVision — environment variable reference
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------

# Groq API key — used by the AI Buyer agent (agent.py)
GROQ_API_KEY=your_groq_api_key_here


# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------

# Razorpay credentials — used for purchase and rental payments
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string (production).
#
# When DATABASE_URL is set, the application connects to PostgreSQL.
# When DATABASE_URL is NOT set, the application uses the local SQLite file
# (backend/shoppilot.db) — this is the default for local development.
#
# Format:
#   postgresql://username:password@host:5432/database_name
#
# Examples:
#   postgresql://bookvision_user:s3cr3t@localhost:5432/bookvision
#   postgresql://bookvision_user:s3cr3t@db.example.com:5432/bookvision
#
# Leave this line commented out for local SQLite development:
# DATABASE_URL=postgresql://username:password@host:5432/bookvision
#
# Uncomment and set for production PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:5432/bookvision


# -----------------------------------------------------------------------------
# Running migrations (PostgreSQL only)
# -----------------------------------------------------------------------------
#
# Once DATABASE_URL is set, apply the schema to a new PostgreSQL database with:
#
#   cd backend
#   python migrate.py
#
# The runner is safe to re-run — already-applied migrations are skipped.
# It will never drop tables or delete data.
# =============================================================================
