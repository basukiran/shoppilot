# Backend environment reference. Copy to backend/.env for local use.
# Keep real credentials in the untracked .env file or deployment secret store.

# Use "production" in deployed environments. Local development uses SQLite
# and permits localhost frontend origins by default.
APP_ENV=development

# Required for purchase and rental checkout. Keep the secret server-side.
# APP_ENV=production requires a live key ID beginning with rzp_live_.
# Never set Razorpay test keys (rzp_test_) in a production environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional AI Buyer key. Leave empty to disable provider-backed AI features.
GROQ_API_KEY=

# Optional PostgreSQL URL. Leave unset/empty for local SQLite. Setting this
# selects PostgreSQL; it does not copy or modify the local SQLite database.
# Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Comma-separated exact frontend origins, including scheme and optional port.
# Production example format: https://shop.example.com,https://www.example.com
# Leave empty for same-origin production deployments.
CORS_ORIGINS=

# Optional comma-separated admin email allowlist. Database roles still apply.
ADMIN_EMAILS=

# Before starting the backend with DATABASE_URL set, run from backend/:
#   python migrate.py
# Then verify without changing the database:
#   python migrate.py --check
